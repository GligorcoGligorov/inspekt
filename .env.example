# Copy to .env (gitignored) and change. docker compose reads .env from the
# project directory automatically.
#
# The compose file falls back to "inspekt-dev" when these are unset. That
# default is for local development only: it is in a public repository.
INSPEKT_DB_PASSWORD=change-me
INSPEKT_GRAFANA_PASSWORD=change-me

# --- Optional: grey-zone LLM review ---
# OFF unless INSPEKT_LLM_ENABLED=true. The key and model below do nothing on
# their own, so having them here cannot send mail to a provider by accident.
# Enable only for a deliberate run, e.g.:
#   INSPEKT_LLM_ENABLED=true docker compose up -d
#   set -a; source .env; set +a; INSPEKT_LLM_ENABLED=true make eval-bec
#INSPEKT_LLM_ENABLED=false
#
# Any OpenAI-compatible chat-completions endpoint works. Example: Groq.
# Get a key at https://console.groq.com/keys and check current model ids at
# https://console.groq.com/docs/models before enabling.
#
# Only the subject and the first 2,000 characters of body text are sent, with
# email addresses, URLs, domains and 6+ digit sequences masked
# (see `inspekt excerpt FILE.eml`). Names and amounts are NOT masked.
#
#INSPEKT_LLM_BASE_URL=https://api.groq.com/openai/v1
#INSPEKT_LLM_MODEL=openai/gpt-oss-20b
#INSPEKT_LLM_API_KEY=gsk_...
#
# Defaults stay well inside Groq's published per-model limits; lower them if
# your account's limits are lower. A 429 pauses all calls for Retry-After.
#INSPEKT_LLM_PER_MINUTE=4
#INSPEKT_LLM_DAILY_CAP=100
#INSPEKT_LLM_TIMEOUT_MS=5000
